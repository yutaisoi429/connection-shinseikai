# Frontend: API server URL. Empty means GitHub Pages demo mode.
VITE_API_BASE_URL=http://localhost:3000

# Backend
PORT=3000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SESSION_DAYS=30

# PostgreSQL (unset to use local JSON storage)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shinseikai
PGSSL=false

# File storage
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# SMTP (unset to save safe email previews under data/mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=真誓会 Connect <no-reply@example.jp>
MAILBOX_DIR=data/mailbox
